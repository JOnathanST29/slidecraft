{
  "name": "slidecraft",
  "version": "0.1.0",
  "description": "TypeScript SDK to generate PowerPoint (.pptx) presentations using LLMs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "powerpoint",
    "pptx",
    "presentation",
    "slides",
    "llm",
    "openai",
    "anthropic",
    "ai",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "openai": "^4.73.0",
    "pptxgenjs": "^3.12.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
